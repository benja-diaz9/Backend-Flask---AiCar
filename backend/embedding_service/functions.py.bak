# functions.py
import json, os, openai, requests, time
from pymongo import MongoClient

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
if not OPENAI_API_KEY:
    raise ValueError("Debes configurar OPENAI_API_KEY.")
client = MongoClient("mongodb://172.17.0.1:27017/")
db = client['assistant_config']
chatbots_collection = db['chatbots']

def get_modes():
    cfg = db['config'].find_one({})
    if not cfg:
        return False, False, "default", None
    return (cfg.get("create_mode", False),
            cfg.get("use_mode", False),
            cfg.get("name_bot", "default"),
            cfg.get("base_id", None))

def get_assistant_config(collection, name):
    bot = collection.find_one({"name": name})
    if not bot:
        raise ValueError(f"No existe '{name}'.")
    return bot

def load_initial_context(chatbot_name):
    cfg = get_assistant_config(chatbots_collection, chatbot_name)
    return "\n".join(cfg.get("instructions", []))

def create_assistant(client, chatbot_name):
    cfg = get_assistant_config(chatbots_collection, chatbot_name)

    # archivos y vector store
    folder = cfg.get("file_name","knowledge_files")
    txts = [f for f in os.listdir(folder) if f.endswith(".txt")]
    vs_id, file_ids = create_vector_store(folder, txts)

    # configurar tool_resources con chunks y ef_search
    tools = cfg.get("tool_resources", {})
    fs = tools.setdefault("file_search", {})
    fs.setdefault("vector_store_ids", []).append(vs_id)
    fs.update({"chunk_size":1000, "chunk_overlap":50, "ef_search":64})
    ci = tools.setdefault("code_interpreter", {})
    ci.setdefault("file_ids", []).extend(file_ids)

    # crear el asistente con esas tool_resources
    assistant = client.beta.assistants.create(
        name=cfg.get("name","Assistant"),
        description=cfg.get("description",""),
        model=cfg.get("model","gpt-4"),
        instructions=cfg.get("instructions", []),
        tools=cfg.get("tools", [{"type":"file_search"},{"type":"code_interpreter"}]),
        tool_resources=tools
    )

    # guardar IDs
    chatbots_collection.update_one(
        {"name": chatbot_name},
        {"$set":{
            "last_chatbot_id": assistant.id,
            "last_vector_store_id": vs_id
        }}
    )
    return assistant.id

def create_vector_store(path, txt_files):
    headers = {
        "Authorization": f"Bearer {OPENAI_API_KEY}",
        "Content-Type": "application/json",
        "OpenAI-Beta": "assistants=v2"
    }
    # crear VS
    r = requests.post("https://api.openai.com/v1/vector_stores",
                      headers=headers, json={"name":"Tramites"})
    vs_id = r.json()['id']
    file_ids=[]
    # subir y asociar
    for f in txt_files:
        up = openai.files.create(file=open(os.path.join(path,f),'rb'),
                                 purpose='assistants')
        fid = up.id
        file_ids.append(fid)
        assoc = f"https://api.openai.com/v1/vector_stores/{vs_id}/files"
        requests.post(assoc, headers=headers, json={"file_id":fid})
        # polling…
        for _ in range(5):
            s = requests.get(assoc, headers=headers).json()['data'][0]['status']
            if s=="completed": break
            time.sleep(5)
    return vs_id, file_ids
